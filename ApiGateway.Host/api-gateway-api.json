        "type": "object",
        "properties": {
          "userTelegramId": {
            "type": "integer",
            "format": "int64"
          },
          "phoneNumber": {
            "type": "string"
          }
        }
      },
      "UserContractProvidedResponse": {
        "type": "object"
      },
      "UserPassport": {
        "required": [
          "surname",
          "givenNames",
          "passportNumber",
          "sex",
          "dateOfBirth"
        ],
        "type": "object",
        "properties": {
          "surname": {
            "type": "string"
          },
          "givenNames": {
            "type": "string"
          },
          "passportNumber": {
            "type": "string"
          },
          "sex": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        },
        "nullable": true
      },
      "UserStatus": {
        "type": "integer"
      }
    }
