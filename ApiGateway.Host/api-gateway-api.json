        "required": [
          "id",
          "status",
          "phoneNumber",
          "passport"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Ulid"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "phoneNumber": {
