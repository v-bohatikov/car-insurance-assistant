{
  "openApiPath": "document-api.json",
  "namespace": "DocumentProcessor.Contracts.ApiClient",
  "outputFolder": "../DocumentProcessor.Contracts/ApiClient",
  "outputFileName": "DocumentApiClient.cs",
  "naming": {
    "useOpenApiTitle": false,
    "interfaceName": "DocumentApiClient"
